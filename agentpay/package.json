{
  "name": "agentpay",
  "version": "1.0.0",
  "description": "Paygent: Bitcoin-native machine-to-machine payment layer for AI agents using Stacks",
  "main": "dist/demo/run.js",
  "scripts": {
    "start": "ts-node src/demo/server.ts",
    "build": "tsc",
    "deploy": "ts-node src/contract/deploy.ts",
    "deploy:v3": "ts-node src/contract/deploy-v3.ts",
    "demo": "ts-node src/demo/run.ts",
    "demo:offline": "OFFLINE_DEMO=true ts-node src/demo/run.ts",
    "agent-b": "ts-node src/agents/agentB.ts",
    "agent-a": "ts-node src/agents/agentA.ts",
    "test": "jest"
  },
  "dependencies": {
    "@noble/secp256k1": "^2.1.0",
    "@noble/hashes": "^1.4.0",
    "@stacks/auth": "^6.14.0",
    "@stacks/encryption": "^6.14.0",
    "@stacks/network": "^6.14.0",
    "@stacks/transactions": "^6.14.0",
    "@stacks/wallet-sdk": "^6.14.0",
    "axios": "^1.7.0",
    "dotenv": "^16.4.0",
    "express": "^4.19.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.4.0",
    "nodemon": "^3.1.0"
  }
}
