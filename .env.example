# Stacks Network
STACKS_NETWORK=testnet

# Agent A — the requester (has STX, wants yield advice)
AGENT_A_MNEMONIC="your 24-word mnemonic here"
AGENT_A_ADDRESS=ST1PQHQKV0RJXZFY1DGX8MNSNYVE3VGZJSRTPGZGM

# Agent B — the provider (sells yield intelligence)
AGENT_B_MNEMONIC="your 24-word mnemonic here"
AGENT_B_ADDRESS=ST2CY5V39NHDPWSXMW9QDT3HC3GD6Q6XX4CFRK9AG
AGENT_B_PRIVATE_KEY=your_agent_b_private_key_hex_here
AGENT_B_PUBLIC_KEY=your_agent_b_compressed_public_key_hex_here

# Contract (fill in after deploy)
CONTRACT_ADDRESS=ST1PQHQKV0RJXZFY1DGX8MNSNYVE3VGZJSRTPGZGM
CONTRACT_NAME=agentpay-escrow

# Payment (microSTX)
PAYMENT_USTX=50

# Ports
AGENT_B_PORT=3001

# Set to "true" to run demo without blockchain calls (~2 second demo)
# OFFLINE_DEMO=true

# Optional SIP-010 token used for escrow payments (x402 flow)
# TOKEN_CONTRACT_ADDRESS=
# TOKEN_CONTRACT_NAME=

# Offline mode needs NONE of the values above: with OFFLINE_DEMO=true, missing
# AGENT_*/CONTRACT_* vars fall back to inert placeholders and a throwaway
# signing key is generated per process. The Vercel entry (api/index.ts) sets
# OFFLINE_DEMO=true automatically when AGENT_B_PRIVATE_KEY is absent.
